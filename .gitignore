# Pristine copies of the game's own data. Never committed: verbatim copyrighted
# game content, and large. Regenerate from the install.
backup/

# Build output
target/

# Unlicensed upstreams: local study references only, never redistributed.
third_party/_reference/

# Obsidian per-machine state (config IS committed; workspace/cache is not)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# scratch
*.tmp

# Forum attachments that are game data rather than tools or documentation.
# Mirrored locally for study; never redistributed.
reference/fable3mod/files/*.bnk
reference/fable3mod/files/*-Content.zip
reference/fable3mod/files/*-1122334400000000.7z.*
reference/fable3mod/files/*-otherfiles.7z

# Extracted script corpus. Game data, regenerated by tools/bnk-extract.ps1.
work/

# Vendored community mod, for study and as the packer's reference bank. The .bnk pair is
# game-format data; the readable source beside it is what matters and IS committed.
reference/injector/*.bnk
reference/injector/*.bnk.dat

# Generated by tools/weapon-unlock.py; machine-specific offsets into the local install.
tools/weapon-unlock-undo.json
